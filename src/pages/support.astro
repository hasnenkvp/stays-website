---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/stays/Button.astro';
import CopyEmailButton from '~/components/stays/CopyEmailButton.astro';
import Faq from '~/components/stays/Faq.astro';
import { stays } from '~/config/stays';

const metadata = {
  title: 'Assistance',
  description: `Assistance Stays : une question, un problème, un signalement ? Écrivez à ${stays.supportEmail}, réponse sous ${stays.supportResponseTime}.`,
  canonical: 'https://staysapp.fr/support/',
};

// Modèle de message : les informations qui aident à répondre vite.
const mailtoSubject = encodeURIComponent('Stays — Assistance');
const mailtoBody = encodeURIComponent(
  `Modèle d’iPhone : \nVersion d’iOS : \nVersion de Stays : \n\nVotre question ou les étapes pour reproduire le problème : \n`
);
const mailtoLink = `mailto:${stays.supportEmail}?subject=${mailtoSubject}&body=${mailtoBody}`;
---

<Layout metadata={metadata}>
  <div class="page-shell pt-12 pb-20 sm:pt-16 lg:pt-24 lg:pb-32">
    <div class="measure mx-auto space-y-20">
      <header>
        <h1 class="text-display text-ink">Assistance</h1>
        <p class="mt-5 text-lead text-ink-soft text-pretty">
          Une question, un problème, un signalement ? Écrivez-nous : réponse sous {stays.supportResponseTime}.
        </p>
      </header>

      <!-- Contact principal -->
      <section aria-labelledby="ecrire">
        <h2 id="ecrire" class="text-title text-ink text-balance">Écrire à l’assistance</h2>
        <p class="mt-5 break-words text-lead">
          <a href={`mailto:${stays.supportEmail}`} class="text-link inline-flex min-h-11 items-center">
            {stays.supportEmail}
          </a>
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <Button variant="primary" href={mailtoLink}>Écrire un e-mail</Button>
          <CopyEmailButton email={stays.supportEmail} label="Copier l’adresse" />
        </div>
      </section>

      <!-- Demandes particulières -->
      <section aria-labelledby="autres-demandes">
        <h2 id="autres-demandes" class="text-title text-ink text-balance">Selon votre demande</h2>
        <dl class="mt-5 divide-y divide-rule border-y border-rule">
          <div class="py-5">
            <dt class="font-semibold text-ink">Données personnelles</dt>
            <dd class="mt-1 text-pretty">
              Pour exercer vos droits ou pour toute question sur vos données :{' '}
              <a href={`mailto:${stays.privacyEmail}`} class="text-link">{stays.privacyEmail}</a>.
            </dd>
          </div>
          <div class="py-5">
            <dt class="font-semibold text-ink">Supprimer vos données Amis</dt>
            <dd class="mt-1 text-pretty">
              Dans les Réglages de l’app, touchez « Supprimer mes données Amis ». Votre profil public et vos partages
              sont supprimés ; vos séjours restent sur votre iPhone.
            </dd>
          </div>
          <div class="py-5">
            <dt class="font-semibold text-ink">Signaler une personne</dt>
            <dd class="mt-1 text-pretty">
              Dans l’onglet Amis, ouvrez « Gérer les amis », puis Signaler. L’app prépare un e-mail vers{' '}
              {stays.supportEmail}, que vous envoyez vous-même. Chaque signalement est examiné sous {
                stays.supportResponseTime
              }.
            </dd>
          </div>
          <div class="py-5">
            <dt class="font-semibold text-ink">Confidentialité</dt>
            <dd class="mt-1 text-pretty">
              Ce que Stays conserve, partage et ne collecte pas :{' '}
              <a href="/privacy/" class="text-link">politique de confidentialité</a>.
            </dd>
          </div>
        </dl>
      </section>

      <!-- Informations utiles -->
      <section aria-labelledby="aider">
        <h2 id="aider" class="text-title text-ink text-balance">Pour nous aider à vous répondre</h2>
        <p class="mt-5">Indiquez si possible dans votre message :</p>
        <ul class="mt-3 list-disc space-y-1.5 pl-5 marker:text-ink-soft">
          <li>le modèle de votre iPhone ;</li>
          <li>la version d’iOS (Réglages &gt; Général &gt; Informations) ;</li>
          <li>la version de Stays ;</li>
          <li>votre question, ou les étapes pour reproduire le problème.</li>
        </ul>
        <p class="mt-6 border-t border-rule pt-4 text-small text-ink-soft text-pretty">
          Ne transmettez jamais de données bancaires. Sur une capture d’écran, masquez toute information personnelle.
        </p>
      </section>

      {
        stays.faq.length > 0 && (
          <section aria-labelledby="faq">
            <h2 id="faq" class="text-title text-ink text-balance">
              Questions fréquentes
            </h2>
            <Faq items={stays.faq} class="mt-5" />
          </section>
        )
      }
    </div>
  </div>
</Layout>
