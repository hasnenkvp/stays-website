---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/stays/Button.astro';
import CopyEmailButton from '~/components/stays/CopyEmailButton.astro';
import Faq from '~/components/stays/Faq.astro';
import { stays } from '~/config/stays';

const metadata = {
  title: 'Assistance',
  description: `Assistance Stays : une question, un problème, un signalement ? Écrivez à ${stays.supportEmail}, réponse sous ${stays.supportResponseTime}.`,
  canonical: 'https://staysapp.fr/support/',
};

// Modèle de message : les informations qui aident à répondre vite.
const mailtoSubject = encodeURIComponent('Stays — Assistance');
const mailtoBody = encodeURIComponent(
  `Modèle d’iPhone : \nVersion d’iOS : \nVersion de Stays : \n\nVotre question ou les étapes pour reproduire le problème : \n`
);
const mailtoLink = `mailto:${stays.supportEmail}?subject=${mailtoSubject}&body=${mailtoBody}`;

const linkClass =
  'text-forest dark:text-brass-light font-medium underline underline-offset-4 hover:text-forest-deep dark:hover:text-white';
---

<Layout metadata={metadata}>
  <div class="py-12 sm:py-20 md:py-24">
    <div class="max-w-3xl mx-auto px-5 sm:px-8 space-y-12 sm:space-y-14">
      <header class="space-y-4">
        <p
          class="font-sans text-[0.8125rem] tracking-[0.14em] uppercase font-semibold text-brass-ink dark:text-brass-light"
        >
          Stays
        </p>
        <h1
          class="font-display font-light text-[2.5rem] sm:text-5xl md:text-6xl leading-[1.08] tracking-tight text-ink"
        >
          Assistance
        </h1>
        <p class="font-sans text-[1.125rem] sm:text-xl text-ink-soft dark:text-sage leading-relaxed max-w-2xl">
          Une question, un problème, un signalement ? Écrivez-nous : réponse sous {stays.supportResponseTime}.
        </p>
      </header>

      <!-- Contact principal -->
      <section
        aria-labelledby="ecrire"
        class="bg-ivory-2/70 dark:bg-ivory-2/40 border border-rule rounded-[24px] p-6 sm:p-8 space-y-5"
      >
        <h2 id="ecrire" class="font-sans text-[0.8125rem] uppercase tracking-[0.12em] font-semibold text-ink-soft">
          Écrire à l’assistance
        </h2>
        <p class="font-display text-[1.625rem] sm:text-3xl text-ink font-normal break-words">
          <a href={`mailto:${stays.supportEmail}`} class="hover:underline underline-offset-4">{stays.supportEmail}</a>
        </p>
        <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3">
          <Button variant="primary" href={mailtoLink}>Écrire un e-mail</Button>
          <CopyEmailButton email={stays.supportEmail} label="Copier l’adresse" />
        </div>
      </section>

      <!-- Demandes particulières -->
      <section aria-labelledby="autres-demandes" class="space-y-6">
        <h2 id="autres-demandes" class="font-display font-light text-[1.75rem] sm:text-3xl tracking-tight text-ink">
          Selon votre demande
        </h2>
        <dl class="divide-y divide-rule border-y border-rule font-sans">
          <div class="py-5 sm:grid sm:grid-cols-3 sm:gap-6">
            <dt class="font-semibold text-ink">Données personnelles</dt>
            <dd class="mt-1 sm:mt-0 sm:col-span-2 text-ink-soft dark:text-sage leading-relaxed">
              Pour exercer vos droits ou pour toute question sur vos données :{' '}
              <a href={`mailto:${stays.privacyEmail}`} class={linkClass}>{stays.privacyEmail}</a>.
            </dd>
          </div>
          <div class="py-5 sm:grid sm:grid-cols-3 sm:gap-6">
            <dt class="font-semibold text-ink">Supprimer vos données Amis</dt>
            <dd class="mt-1 sm:mt-0 sm:col-span-2 text-ink-soft dark:text-sage leading-relaxed">
              Dans les Réglages de l’app, touchez « Supprimer mes données Amis ». Votre profil public et vos partages
              sont supprimés ; vos séjours restent sur votre iPhone.
            </dd>
          </div>
          <div class="py-5 sm:grid sm:grid-cols-3 sm:gap-6">
            <dt class="font-semibold text-ink">Signaler une personne</dt>
            <dd class="mt-1 sm:mt-0 sm:col-span-2 text-ink-soft dark:text-sage leading-relaxed">
              Dans l’onglet Amis, ouvrez « Gérer les amis », puis Signaler. L’app prépare un e-mail vers{' '}
              {stays.supportEmail}, que vous envoyez vous-même. Chaque signalement est examiné sous {
                stays.supportResponseTime
              }.
            </dd>
          </div>
          <div class="py-5 sm:grid sm:grid-cols-3 sm:gap-6">
            <dt class="font-semibold text-ink">Confidentialité</dt>
            <dd class="mt-1 sm:mt-0 sm:col-span-2 text-ink-soft dark:text-sage leading-relaxed">
              Ce que Stays conserve, partage et ne collecte pas :{' '}
              <a href="/privacy/" class={linkClass}>politique de confidentialité</a>.
            </dd>
          </div>
        </dl>
      </section>

      <!-- Informations utiles -->
      <section aria-labelledby="aider" class="space-y-4">
        <h2 id="aider" class="font-display font-light text-[1.75rem] sm:text-3xl tracking-tight text-ink">
          Pour nous aider à vous répondre
        </h2>
        <p class="font-sans text-[1.0625rem] text-ink-soft dark:text-sage leading-relaxed">
          Indiquez si possible dans votre message :
        </p>
        <ul class="space-y-2.5 font-sans text-[1.0625rem] text-ink-soft dark:text-sage">
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-brass dark:bg-brass-light mt-[0.6em] shrink-0" aria-hidden="true"
            ></span>
            <span>le modèle de votre iPhone ;</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-brass dark:bg-brass-light mt-[0.6em] shrink-0" aria-hidden="true"
            ></span>
            <span>la version d’iOS (Réglages &gt; Général &gt; Informations) ;</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-brass dark:bg-brass-light mt-[0.6em] shrink-0" aria-hidden="true"
            ></span>
            <span>la version de Stays ;</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-brass dark:bg-brass-light mt-[0.6em] shrink-0" aria-hidden="true"
            ></span>
            <span>votre question, ou les étapes pour reproduire le problème.</span>
          </li>
        </ul>
        <p class="pt-4 border-t border-rule font-sans text-[0.9375rem] text-ink-soft dark:text-sage leading-relaxed">
          Ne transmettez jamais de données bancaires. Sur une capture d’écran, masquez toute information personnelle.
        </p>
      </section>

      {
        stays.faq.length > 0 && (
          <section aria-labelledby="faq" class="space-y-6">
            <h2 id="faq" class="font-display font-light text-[1.75rem] sm:text-3xl tracking-tight text-ink">
              Questions fréquentes
            </h2>
            <Faq items={stays.faq} />
          </section>
        )
      }
    </div>
  </div>
</Layout>
