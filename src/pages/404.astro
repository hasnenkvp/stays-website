---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/stays/Button.astro';
import { getHomePermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Page non trouvée — Stays',
  ignoreTitleTemplate: true,
  robots: {
    index: false,
    follow: false,
  },
};
---

<Layout metadata={metadata}>
  <section class="page-shell flex flex-col items-center pt-16 pb-24 text-center sm:pt-24 lg:pt-32 lg:pb-40">
    <h1 class="text-display text-ink text-balance">Page introuvable</h1>
    <p class="mt-5 max-w-[32rem] text-lead text-ink-soft text-pretty">
      L’adresse demandée n’existe pas ou a été déplacée.
    </p>
    <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row">
      <Button variant="primary" href={getHomePermalink()}>Retour à l’accueil</Button>
      <Button variant="secondary" href="/support/">Assistance</Button>
    </div>
  </section>
</Layout>
