---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import AppScreenshot from '~/components/stays/AppScreenshot.astro';
import Availability from '~/components/stays/Availability.astro';
import { SITE, I18N } from 'astrowind:config';

import capSejours from '~/assets/images/app/01-sejours.png';
import capFiche from '~/assets/images/app/02-fiche.png';
import capPasseport from '~/assets/images/app/04-passeport.png';
import capAmis from '~/assets/images/app/05-amis.png';

const metadata = {
  title: 'Stays — Tous vos séjours, au même endroit',
  ignoreTitleTemplate: true,
  description:
    'Booking, Airbnb ou le site de l’hôtel : Stays réunit vos séjours dans un carnet pour iPhone, les partage avec ceux qui voyagent avec vous et en tire vos statistiques de voyage.',
  canonical: 'https://staysapp.fr/',
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL('/stays-logo.png', SITE?.site).toString(),
  },
];

// Rôles partagés par les trois sections de fonctions.
const section = 'py-20 lg:py-32';
const grid = 'page-shell grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-20';
const copy = 'measure w-full';
const shot = 'mx-auto w-[260px] sm:w-[300px] lg:w-[320px]';
const shotSizes = '(max-width: 640px) 260px, (max-width: 1024px) 300px, 320px';
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero : la promesse, la disponibilité et l'app -->
  <section aria-labelledby="titre" class="pt-12 pb-20 sm:pt-16 lg:pt-24 lg:pb-32">
    <div class="page-shell flex flex-col items-center text-center">
      <h1 id="titre" class="max-w-[12em] text-display text-ink text-balance">Tous vos séjours, au même endroit.</h1>
      <p class="mt-5 max-w-[34rem] text-lead text-ink-soft text-balance">
        Booking, Airbnb ou le site de l’hôtel : où que vous ayez réservé, Stays réunit vos séjours dans un carnet.
      </p>
      <Availability class="mt-8" />
      <figure class="mt-12 w-[260px] sm:mt-16 sm:w-[300px] lg:w-[360px]">
        <AppScreenshot
          src={capSejours}
          alt="Stays sur iPhone : la liste des séjours à venir, du Park Hyatt Tokyo à l’InterContinental Bora-Bora."
          class="w-full"
          sizes="(max-width: 640px) 260px, (max-width: 1024px) 300px, 360px"
          priority
        />
        <figcaption class="mt-6 text-small text-ink-soft">Captures réalisées avec des séjours d’exemple.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Le jour J : la fiche du séjour -->
  <section id="jour-j" aria-labelledby="jour-j-titre" class:list={[section, 'border-t border-rule']}>
    <div class={grid}>
      <div class={copy}>
        <h2 id="jour-j-titre" class="text-title text-ink text-balance">Le jour J, tout est déjà là.</h2>
        <p class="mt-5 text-pretty">
          Ajoutez un séjour en cherchant l’hôtel, puis gardez ce qui vous sera utile : dates et heures, référence,
          plateforme, montant, notes.
        </p>
        <p class="mt-4 text-pretty">
          Le jour de l’arrivée, la fiche réunit l’adresse sur le plan, l’heure d’arrivée, la référence à donner à la
          réception et le numéro de l’hôtel. Sans mail à retrouver, ni autre application à ouvrir.
        </p>
      </div>
      <AppScreenshot
        src={capFiche}
        alt="Fiche du Park Hyatt Tokyo dans Stays : dates, arrivée à 15 h, départ à 12 h, référence de réservation, montant réglé et plan."
        class={shot}
        sizes={shotSizes}
      />
    </div>
  </section>

  <!-- Amis : l'exemple de la Grèce -->
  <section id="amis" aria-labelledby="amis-titre" class:list={[section, 'border-t border-rule']}>
    <div class={grid}>
      <div class={copy}>
        <h2 id="amis-titre" class="text-title text-ink text-balance">Partir à plusieurs, sans transférer de mails.</h2>
        <p class="mt-5 text-pretty">
          Vous partez en Grèce à deux. Votre ami a réservé l’hôtel sur Booking ; vous n’avez que le nom de l’île.
          D’habitude, il faut qu’il vous transfère le mail ou une capture d’écran.
        </p>
        <p class="mt-4 text-pretty">
          Si vous êtes amis dans Stays, son séjour apparaît aussi dans votre app : l’hôtel, les dates, les heures
          d’arrivée et de départ, et sa place sur la carte.
        </p>
        <p class="mt-6 max-w-[24rem] text-small text-ink-soft text-pretty">
          Rien n’est partagé avant l’acceptation d’une demande, et jamais les prix, photos, notes ni références. Amis
          est facultatif et demande iOS 26 et iCloud.
        </p>
      </div>
      <AppScreenshot
        src={capAmis}
        alt="Onglet Amis de Stays : les séjours en cours et à venir de Camille, partagés sans prix, photo, note ni référence."
        class:list={[shot, 'lg:order-first']}
        sizes={shotSizes}
      />
    </div>
  </section>

  <!-- Statistiques : le Passeport -->
  <section id="passeport" aria-labelledby="passeport-titre" class:list={[section, 'border-t border-rule']}>
    <div class={grid}>
      <div class={copy}>
        <h2 id="passeport-titre" class="text-title text-ink text-balance">Votre passeport, en chiffres.</h2>
        <p class="mt-5 text-pretty">
          Pour les curieux et les amateurs de chiffres, le Passeport compte vos nuits, vos pays, vos villes et vos
          hôtels, année par année. Chaque séjour devient un point sur le globe.
        </p>
        <p class="mt-4 text-pretty">Une belle année ? Stays en fait une image à partager.</p>
      </div>
      <AppScreenshot
        src={capPasseport}
        alt="Passeport de Stays : 31 nuits, 7 pays, 9 villes et 9 hôtels sur 2 années, sous le globe des séjours."
        class={shot}
        sizes={shotSizes}
      />
    </div>
  </section>

  <!-- Vie privée : bloc discret -->
  <section id="vie-privee" aria-labelledby="vie-privee-titre" class="bg-canvas-alt py-20 lg:py-32">
    <div class="page-shell grid grid-cols-1 gap-6 lg:grid-cols-2 lg:gap-20">
      <h2 id="vie-privee-titre" class="max-w-[24rem] text-title text-ink text-balance">
        Vos séjours restent sur votre iPhone.
      </h2>
      <div class="measure">
        <p class="text-pretty">
          Stays ne vous demande pas de créer de compte et n’exploite aucun serveur. Vos séjours, vos photos et vos notes
          sont enregistrés sur votre iPhone, et dans sa sauvegarde si vous l’avez activée.
        </p>
        <p class="mt-4 text-pretty">
          Seule la fonction Amis, si vous l’utilisez, passe par votre iCloud. Pour tout retirer, touchez « Supprimer mes
          données Amis » dans les Réglages de l’app : votre profil public et vos partages sont supprimés, vos séjours
          restent sur l’iPhone.
        </p>
        <p class="mt-4">
          <a href="/privacy/" class="text-link inline-flex min-h-11 items-center"
            >Lire la politique de confidentialité</a
          >
        </p>
      </div>
    </div>
  </section>

  <!-- Fin : l'app, en une phrase -->
  <section aria-labelledby="fin-titre" class="py-20 lg:py-32">
    <div class="page-shell flex flex-col items-center text-center">
      <img src="/stays-logo.png" alt="" width="72" height="72" class="h-18 w-18 rounded-[16px] shadow-shot" />
      <h2 id="fin-titre" class="mt-6 text-title text-ink text-balance">Stays, l’essentiel de vos séjours.</h2>
      <Availability class="mt-6" />
    </div>
  </section>
</Layout>
