---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import Button from '~/components/stays/Button.astro';
import SectionHeading from '~/components/stays/SectionHeading.astro';
import ScreenshotPlaceholder from '~/components/stays/ScreenshotPlaceholder.astro';
import HeroLandscapeMockup from '~/components/stays/HeroLandscapeMockup.astro';
import AppStoreBadge from '~/components/stays/AppStoreBadge.astro';
import Faq from '~/components/stays/Faq.astro';
import { stays } from '~/config/stays';
import { SITE, I18N } from 'astrowind:config';

const metadata = {
  title: 'Stays — Gardez la mémoire de chaque séjour',
  ignoreTitleTemplate: true,
  description:
    'Conservez la mémoire de vos séjours à l’hôtel : établissements, photos, notes personnelles et passeport de voyage, dans une application privée pour iPhone.',
  canonical: 'https://staysapp.fr/',
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL('/stays-logo.png', SITE?.site).toString(),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- 1. HERO SECTION (#haut) -->
  <section id="haut" class="relative pt-16 pb-12 sm:pt-20 sm:pb-16 md:pt-28 md:pb-20 lg:pt-32 lg:pb-24 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <!-- Hero Editorial Block (Top, Centered) -->
      <div class="relative z-20 max-w-4xl mx-auto text-center space-y-6 sm:space-y-8">
        <p
          class="font-sans text-[0.8125rem] tracking-[0.16em] uppercase font-semibold text-brass-ink dark:text-brass-light"
        >
          Application iOS · Séjours & voyages
        </p>

        <h1
          class="font-display font-light text-[2.5rem] sm:text-5xl md:text-6xl lg:text-[4.25rem] leading-[1.08] tracking-tight text-ink text-balance max-w-4xl mx-auto"
        >
          Vos séjours passent. <em class="italic font-normal text-forest dark:text-brass-light"
            >Les souvenirs restent.</em
          >
        </h1>

        <p
          class="font-sans text-[1.125rem] sm:text-xl text-ink-soft dark:text-sage leading-relaxed max-w-2xl mx-auto text-pretty"
        >
          Vos hôtels, vos souvenirs et votre passeport de voyage, réunis dans Stays. Une façon personnelle de garder une
          trace de vos escales et de les partager avec vos proches.
        </p>

        <!-- Action buttons -->
        {
          stays.appStoreUrl && (
            <div class="flex items-center justify-center pt-2">
              <AppStoreBadge />
            </div>
          )
        }
      </div>

      <!-- Hero Landscape Mockup Slot (Bottom, Deployed wide) -->
      <div class="relative z-10 mt-8 sm:mt-12 lg:-mt-12 xl:-mt-16 flex justify-center">
        <HeroLandscapeMockup priority="eager" />
      </div>
    </div>
  </section>

  <!-- 2. SECTION « LE SÉJOUR » (#sejour) -->
  <!-- Direct composition centered around the real mockup, title, and subtitle, without the 3 redundant card boxes -->
  <section id="sejour" class="relative py-20 sm:py-28 md:py-32 border-t border-rule scroll-mt-16 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Editorial Text Column (Clean & uncluttered) -->
        <div class="lg:col-span-6 space-y-6 lg:space-y-8">
          <SectionHeading
            eyebrow="LE SÉJOUR"
            title="Chaque séjour, <em class='italic font-normal text-forest dark:text-brass-light'>dans les détails</em>."
            lede="Retrouvez vos hôtels, vos photos et vos notes personnelles. L’essentiel de vos séjours, réuni au même endroit."
          />

          <!-- Discreet, refined typographical cue list replacing the 3 redundant boxes -->
          <ul
            class="pt-4 border-t border-rule flex flex-wrap gap-x-6 gap-y-2 text-[0.9375rem] text-ink-soft dark:text-sage font-sans"
          >
            <li class="inline-flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brass dark:bg-brass-light" aria-hidden="true"></span>
              Établissement & lieu
            </li>
            <li class="inline-flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brass dark:bg-brass-light" aria-hidden="true"></span>
              Photos personnelles
            </li>
            <li class="inline-flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brass dark:bg-brass-light" aria-hidden="true"></span>
              Notes & souvenirs
            </li>
            <li class="inline-flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-brass dark:bg-brass-light" aria-hidden="true"></span>
              Repères d’escale
            </li>
          </ul>
        </div>

        <!-- Real Mockup Slot (Prominent and clear) -->
        <div class="lg:col-span-6 flex justify-center lg:justify-end">
          <ScreenshotPlaceholder
            id="sejour"
            title="Fiche de séjour"
            subtitle="Détails de l’hôtel, dates, photos et notes personnelles"
            alt="Fiche détaillée d’un séjour dans l’application Stays"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 3. SECTION « LE PASSEPORT » (#passeport) -->
  <!-- Showcase of mockup and real available statistics: Pays, Villes, Séjours, Nuits -->
  <section
    id="passeport"
    class="relative py-20 sm:py-28 md:py-32 border-t border-rule scroll-mt-16 bg-ivory/40 dark:bg-ivory-2/15 overflow-hidden"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Mockup Slot (Left on desktop) -->
        <div class="lg:col-span-6 order-2 lg:order-1 flex justify-center lg:justify-start">
          <ScreenshotPlaceholder
            id="passeport"
            title="Le Passeport"
            subtitle="Synthèse de vos voyages, pays visités et nuits cumulées"
            alt="Vue passeport de l’application Stays présentant les voyages et statistiques"
          />
        </div>

        <!-- Content & Typographical Stats (Right on desktop) -->
        <div class="lg:col-span-6 order-1 lg:order-2 space-y-8">
          <SectionHeading
            eyebrow="LE PASSEPORT"
            title="Le passeport, <em class='italic font-normal text-forest dark:text-brass-light'>vos voyages réunis</em>."
            lede="Le passeport rassemble vos statistiques de voyage en un coup d’œil : pays explorés, villes d’escale, nombre de séjours et nuits cumulées au fil des années."
          />

          <!-- Typographical Travel Statistics Strip (No fake numbers, just the real categories tracked by Stays) -->
          <div class="p-6 sm:p-8 rounded-[24px] bg-paper dark:bg-forest-deep border border-rule/80 space-y-6">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-center sm:text-left">
              <div>
                <span
                  class="block font-display italic text-2xl sm:text-3xl text-forest dark:text-brass-light font-normal"
                >
                  Pays
                </span>
                <span
                  class="block font-sans text-[0.8125rem] tracking-wider uppercase text-ink-soft dark:text-sage mt-1"
                >
                  Traversés
                </span>
              </div>

              <div>
                <span
                  class="block font-display italic text-2xl sm:text-3xl text-forest dark:text-brass-light font-normal"
                >
                  Villes
                </span>
                <span
                  class="block font-sans text-[0.8125rem] tracking-wider uppercase text-ink-soft dark:text-sage mt-1"
                >
                  Explorées
                </span>
              </div>

              <div>
                <span
                  class="block font-display italic text-2xl sm:text-3xl text-forest dark:text-brass-light font-normal"
                >
                  Séjours
                </span>
                <span
                  class="block font-sans text-[0.8125rem] tracking-wider uppercase text-ink-soft dark:text-sage mt-1"
                >
                  Consignés
                </span>
              </div>

              <div>
                <span
                  class="block font-display italic text-2xl sm:text-3xl text-forest dark:text-brass-light font-normal"
                >
                  Nuits
                </span>
                <span
                  class="block font-sans text-[0.8125rem] tracking-wider uppercase text-ink-soft dark:text-sage mt-1"
                >
                  Cumulées
                </span>
              </div>
            </div>

            <p
              class="font-sans text-[0.9375rem] text-ink-soft dark:text-sage border-t border-rule pt-4 leading-relaxed"
            >
              Une archive personnelle qui grandit à chaque escale, sans profil public ni mise en scène.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. SECTION « AMIS » (#amis) -->
  <!-- Intimate, centered showcase: short title, 2 sentences, 3 cues maximum, no technical CloudKit jargon -->
  <section id="amis" class="relative py-20 sm:py-28 md:py-32 border-t border-rule scroll-mt-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <SectionHeading
        eyebrow="AMIS"
        title="Partager ses séjours, <em class='italic font-normal text-forest dark:text-brass-light'>simplement avec ses proches</em>."
        lede="Échangez vos séjours avec les personnes de votre choix, grâce à un code à 6 chiffres. Un partage privé et réciproque, loin de tout réseau social ouvert."
        align="center"
      />

      <!-- 3 Clear Cues (Cards replaced with an airy, refined trio) -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 text-left">
        <div class="p-6 rounded-[20px] bg-ivory-2/60 dark:bg-ivory-2/20 border border-rule/70">
          <div class="w-6 h-[2px] bg-brass dark:bg-brass-light rounded-full mb-3" aria-hidden="true"></div>
          <h3 class="font-display font-medium text-xl text-ink tracking-tight mb-1.5">Sur acceptation</h3>
          <p class="font-sans text-[0.9375rem] text-ink-soft dark:text-sage leading-relaxed">
            Rien n’est partagé tant que vous n’avez pas accepté la demande d’une personne.
          </p>
        </div>

        <div class="p-6 rounded-[20px] bg-ivory-2/60 dark:bg-ivory-2/20 border border-rule/70">
          <div class="w-6 h-[2px] bg-brass dark:bg-brass-light rounded-full mb-3" aria-hidden="true"></div>
          <h3 class="font-display font-medium text-xl text-ink tracking-tight mb-1.5">L’essentiel seulement</h3>
          <p class="font-sans text-[0.9375rem] text-ink-soft dark:text-sage leading-relaxed">
            Hôtel, ville et dates. Jamais vos prix, photos, notes ni références de réservation.
          </p>
        </div>

        <div class="p-6 rounded-[20px] bg-ivory-2/60 dark:bg-ivory-2/20 border border-rule/70">
          <div class="w-6 h-[2px] bg-brass dark:bg-brass-light rounded-full mb-3" aria-hidden="true"></div>
          <h3 class="font-display font-medium text-xl text-ink tracking-tight mb-1.5">Contrôle permanent</h3>
          <p class="font-sans text-[0.9375rem] text-ink-soft dark:text-sage leading-relaxed">
            Retirez, bloquez ou signalez une personne à tout moment. Le retrait coupe l’accès dans les deux sens.
          </p>
        </div>
      </div>

      <div class="mt-8 space-y-2">
        <p class="font-sans text-[0.9375rem] text-ink-soft dark:text-sage">
          Amis est facultatif et demande iOS 26 et un compte iCloud. Le reste de l’app fonctionne sans.
        </p>
        <a
          href="/privacy/#c-amis--partage-de-vos-séjours-cloudkit"
          class="inline-flex min-h-11 items-center font-sans text-[0.9375rem] text-forest dark:text-brass-light font-medium underline underline-offset-4 hover:text-forest-deep dark:hover:text-white transition-colors duration-150"
        >
          Le fonctionnement d’Amis en détail, dans la politique de confidentialité
        </a>
      </div>
    </div>
  </section>

  <!-- 5. SECTION « CONFIDENTIALITÉ » (#confidentialite) -->
  <!-- Shortened, technical jargon removed (no SwiftData, IDFA, SDK), confirmed guarantees only -->
  <section
    id="confidentialite"
    class="relative py-20 sm:py-28 md:py-32 bg-forest dark:bg-forest-deep text-[#fbf8f2] scroll-mt-16 not-prose"
    data-surface="inverse"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-8 space-y-6">
          <p class="font-sans text-[0.8125rem] tracking-[0.14em] uppercase font-semibold text-brass-light">
            Confidentialité
          </p>

          <h2
            class="font-display font-light text-[2rem] sm:text-4xl md:text-5xl leading-[1.1] tracking-tight text-[#fbf8f2] text-balance"
          >
            Privé <em class="italic font-normal text-brass-light">par conception</em>.
          </h2>

          <p class="font-sans text-[1.0625rem] sm:text-lg text-sage leading-relaxed max-w-2xl text-pretty">
            Vos séjours, vos notes et vos photos sont conservés sur votre iPhone. Aucun compte à créer, aucun serveur
            pour analyser vos voyages et aucune revente de données.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4 border-t border-rule-inverse/25">
            <div>
              <h3 class="font-display text-xl text-[#fbf8f2] mb-1">Sur votre appareil</h3>
              <p class="font-sans text-[0.9375rem] text-sage leading-relaxed">
                Stockage local sur votre iPhone, protégé par le chiffrement matériel d’iOS.
              </p>
            </div>
            <div>
              <h3 class="font-display text-xl text-[#fbf8f2] mb-1">Sans intermédiaire</h3>
              <p class="font-sans text-[0.9375rem] text-sage leading-relaxed">
                Aucun serveur propriétaire. Seule la fonction Amis, si vous l’utilisez, passe par iCloud.
              </p>
            </div>
            <div>
              <h3 class="font-display text-xl text-[#fbf8f2] mb-1">Sans pistage</h3>
              <p class="font-sans text-[0.9375rem] text-sage leading-relaxed">
                Aucune publicité, aucun outil de suivi d’activité et aucun ciblage.
              </p>
            </div>
          </div>

          <div class="pt-4">
            <Button variant="inverse" href="/privacy/"> Lire la politique de confidentialité </Button>
          </div>
        </div>

        <div class="lg:col-span-4 hidden lg:flex justify-end">
          <div
            class="relative w-56 h-56 rounded-[32px] bg-forest-deep dark:bg-black/50 border border-rule-inverse/30 p-8 flex flex-col items-center justify-center text-center shadow-float"
          >
            <img
              src="/stays-logo.png"
              alt=""
              class="w-20 h-20 rounded-[18px] object-cover mb-4 ring-1 ring-brass-light/20"
              width="80"
              height="80"
            />
            <span class="font-display italic text-lg text-brass-light">Mémoire privée</span>
            <span class="font-sans text-[0.8125rem] text-sage uppercase tracking-wider mt-1"> Sur votre appareil </span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. SECTION « QUESTIONS FRÉQUENTES » (#faq) -->
  <!-- Concise, useful, no repetition with sections above -->
  <section id="faq" class="relative py-20 sm:py-28 md:py-32 border-t border-rule scroll-mt-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <SectionHeading
        eyebrow="QUESTIONS FRÉQUENTES"
        title="Des réponses <em class='italic font-normal text-forest dark:text-brass-light'>courtes et utiles</em>."
        lede="L’essentiel pour comprendre ce que fait Stays, et ce qu’elle ne fait pas."
        align="center"
      />

      <Faq items={stays.faq} />
    </div>
  </section>

  <!-- 7. CTA FINAL & CLÔTURE (#contact) -->
  <section id="contact" class="relative py-20 sm:py-28 md:py-32 border-t border-rule scroll-mt-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center space-y-6">
      <h2
        class="font-display font-light text-[2rem] sm:text-4xl md:text-5xl leading-tight tracking-tight text-ink text-balance"
      >
        Vos séjours passent. <em class="italic font-normal text-forest dark:text-brass-light">Les souvenirs restent.</em
        >
      </h2>

      <p class="font-sans text-[1.0625rem] sm:text-lg text-ink-soft dark:text-sage leading-relaxed max-w-lg mx-auto">
        Une question, une remarque ou besoin d’aide ? Écrivez-nous à <a
          href={`mailto:${stays.supportEmail}`}
          class="text-forest dark:text-brass-light font-medium underline underline-offset-4">{stays.supportEmail}</a
        >. Réponse sous {stays.supportResponseTime}.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        {stays.appStoreUrl && <AppStoreBadge />}
        <Button variant="secondary" href="/support/"> Page d’assistance </Button>
      </div>

      <div class="pt-2">
        <a
          href="/privacy/"
          class="inline-flex min-h-11 items-center font-sans text-[0.9375rem] text-ink-soft dark:text-sage underline underline-offset-4 hover:text-ink dark:hover:text-ink transition-colors"
        >
          Consulter la politique de confidentialité
        </a>
      </div>
    </div>
  </section>
</Layout>
