---
import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import AppScreenshot from '~/components/stays/AppScreenshot.astro';
import Availability from '~/components/stays/Availability.astro';
import Faq from '~/components/stays/Faq.astro';
import { stays, homeFaq, isAppStoreUrlPlaceholder } from '~/config/stays';
import { SITE, I18N } from 'astrowind:config';

import sejoursLight from '~/assets/images/app/01-sejours-light.png';
import sejoursDark from '~/assets/images/app/01-sejours-dark.png';
import ficheLight from '~/assets/images/app/02-fiche-light.png';
import ficheDark from '~/assets/images/app/02-fiche-dark.png';
import passeportLight from '~/assets/images/app/04-passeport-light.png';
import passeportDark from '~/assets/images/app/04-passeport-dark.png';
import amisLight from '~/assets/images/app/05-amis-light.png';
import amisDark from '~/assets/images/app/05-amis-dark.png';

const description =
  'Stays réunit votre historique hôtelier sur iPhone : vos hôtels sur un globe, un passeport de voyage chiffré (nuits, pays, villes, chaînes) et le partage entre amis.';

const metadata = {
  title: 'Stays — Carnet de séjours hôteliers pour iPhone',
  ignoreTitleTemplate: true,
  description,
  canonical: 'https://staysapp.fr/',
};

const site = SITE?.site ?? 'https://staysapp.fr';
const organizationId = `${site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site}/#website`,
    name: SITE?.name,
    url: site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: site,
    logo: new URL('/stays-logo.png', site).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    '@id': `${site}/#app`,
    name: 'Stays',
    description,
    url: site,
    image: new URL('/og-image.png', site).toString(),
    operatingSystem: 'iOS',
    softwareRequirements: 'iOS 18.6 ou version ultérieure',
    applicationCategory: 'TravelApplication',
    inLanguage: 'fr',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    publisher: { '@id': organizationId },
    // Lien de téléchargement annoncé seulement quand APP_STORE_URL est la vraie fiche.
    ...(isAppStoreUrlPlaceholder ? {} : { downloadUrl: stays.appStoreUrl, installUrl: stays.appStoreUrl }),
  },
];

// Tuiles avec capture : texte et capture côte à côte dès 640 px ; les tuiles de demi-largeur
// repassent le texte au-dessus de la capture dès 1 024 px, pour garder une ligne confortable.
const tileWithShot = 'tile reveal flex flex-col gap-8 p-6 sm:flex-row sm:items-center sm:p-8';
const tileStacked = 'lg:flex-col lg:items-stretch';
const tileShot = 'mx-auto w-[200px] shrink-0 sm:mx-0';
const tileShotStacked = 'lg:mx-auto';
const tileShotSizes = '200px';
const tileText = 'flex-1';

// Chiffres du Passeport, repris de la capture d'exemple.
const passportFigures = [
  { value: '34', label: 'nuits' },
  { value: '9', label: 'pays' },
  { value: '10', label: 'villes' },
  { value: '10', label: 'hôtels' },
];

// Pourquoi pas un tableur : ce que l'on fait à la main, ce que Stays fait.
const comparison = [
  {
    topic: 'Ajouter un séjour',
    sheet: 'Remplir chaque colonne à la main.',
    stays: 'Chercher l’hôtel : la ville, le pays et la chaîne se remplissent.',
  },
  {
    topic: 'Le jour J',
    sheet: 'Retrouver la bonne ligne, puis le mail.',
    stays: 'La fiche : adresse, plan, heure d’arrivée, référence.',
  },
  {
    topic: 'Vos voyages',
    sheet: 'Des lignes et des totaux.',
    stays: 'Un globe et un passeport chiffré, année par année.',
  },
  {
    topic: 'Entre amis',
    sheet: 'Transférer un mail ou une capture.',
    stays: 'Les séjours de vos amis, dans l’app.',
  },
  {
    topic: 'Vos données',
    sheet: 'Là où vous les avez rangées.',
    stays: 'Sur votre iPhone, exportables en CSV.',
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero : la promesse, le téléchargement et l'app -->
  <section aria-labelledby="titre" class="pt-12 pb-20 sm:pt-16 lg:pt-24 lg:pb-28">
    <div class="page-shell flex flex-col items-center text-center">
      <h1 id="titre" class="max-w-[15em] text-display text-ink text-balance">
        <span class="whitespace-nowrap">Chaque hôtel,</span>{' '}
        <span class="whitespace-nowrap">chaque nuit,</span>{' '}
        <span class="whitespace-nowrap">au même endroit.</span>
      </h1>
      <p class="mt-5 max-w-[32rem] text-lead text-ink-soft text-balance">
        Stays réunit votre historique hôtelier, place chaque séjour sur le globe et en tire vos statistiques : nuits,
        pays, villes, chaînes.
      </p>
      <Availability class="mt-8" />
      <figure class="mt-12 w-[260px] sm:mt-16 sm:w-[300px] lg:w-[340px]">
        <AppScreenshot
          light={sejoursLight}
          dark={sejoursDark}
          alt="Stays sur iPhone : la liste des séjours à venir, du Park Hyatt Paris-Vendôme au Mystique de Santorin."
          class="w-full"
          sizes="(max-width: 640px) 260px, (max-width: 1024px) 300px, 340px"
          priority
        />
        <figcaption class="mt-6 text-small text-ink-soft">Captures réalisées avec des séjours d’exemple.</figcaption>
      </figure>
    </div>
  </section>

  <!-- Fonctions : grille de tuiles (bento) -->
  <section id="fonctions" aria-labelledby="fonctions-titre" class="border-t border-rule py-20 lg:py-28">
    <div class="page-shell">
      <div class="measure">
        <h2 id="fonctions-titre" class="text-title text-ink text-balance">
          Votre historique hôtelier, en un coup d’œil.
        </h2>
        <p class="mt-5 text-ink-soft text-pretty">
          Une app native pour iPhone, pensée pour ceux qui passent beaucoup de nuits à l’hôtel.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-4 lg:grid-cols-12 lg:gap-5">
        <!-- Carte -->
        <article class:list={[tileWithShot, 'lg:col-span-7']} aria-labelledby="tuile-carte">
          <div class={tileText}>
            <h3 id="tuile-carte" class="text-heading text-ink">Tous vos hôtels sur le globe.</h3>
            <p class="mt-3 text-ink-soft text-pretty">
              Chaque séjour devient un point sur le globe d’Apple Plans. Faites‑le tourner pour retrouver où vous avez
              dormi, d’un continent à l’autre.
            </p>
          </div>
          <AppScreenshot
            light={passeportLight}
            dark={passeportDark}
            alt="Le globe de Stays : les hôtels de l’exemple placés en Europe, au-dessus du Passeport."
            class={tileShot}
            sizes={tileShotSizes}
          />
        </article>

        <!-- Statistiques et Passeport -->
        <article class="tile reveal flex flex-col p-6 sm:p-8 lg:col-span-5" aria-labelledby="tuile-stats">
          <h3 id="tuile-stats" class="text-heading text-ink">Votre passeport, en chiffres.</h3>
          <p class="mt-3 text-ink-soft text-pretty">
            Nuits, pays, villes et hôtels, année par année. Vos chaînes préférées et vos records : plus long séjour,
            ville et hôtel les plus fréquentés.
          </p>
          <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-6 lg:mt-auto lg:pt-8">
            {
              passportFigures.map((figure) => (
                <div class="border-t border-rule pt-3">
                  <dt class="text-small text-ink-soft">{figure.label}</dt>
                  <dd class="mt-1 text-display text-ink tabular-nums">{figure.value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-6 text-small text-ink-soft">Chiffres de l’exemple, sur deux années.</p>
        </article>

        <!-- Le jour J -->
        <article class:list={[tileWithShot, tileStacked, 'lg:col-span-6']} aria-labelledby="tuile-jour-j">
          <div class={tileText}>
            <h3 id="tuile-jour-j" class="text-heading text-ink">Le jour J, tout est là.</h3>
            <p class="mt-3 text-ink-soft text-pretty">
              Adresse et plan, heure d’arrivée, référence à donner à la réception : la fiche du séjour, sans mail à
              retrouver.
            </p>
          </div>
          <AppScreenshot
            light={ficheLight}
            dark={ficheDark}
            alt="Fiche du Park Hyatt Paris-Vendôme dans Stays : du 3 au 6 décembre 2026, arrivée à 15 h, départ à 12 h, référence de réservation, montant réglé, plan et adresse."
            class:list={[tileShot, tileShotStacked]}
            sizes={tileShotSizes}
          />
        </article>

        <!-- Amis -->
        <article class:list={[tileWithShot, tileStacked, 'lg:col-span-6']} aria-labelledby="tuile-amis">
          <div class={tileText}>
            <h3 id="tuile-amis" class="text-heading text-ink">Vos séjours, entre amis.</h3>
            <p class="mt-3 text-ink-soft text-pretty">
              Une fois amis dans Stays, chacun voit les séjours de l’autre : l’hôtel, la ville et les dates. Prix,
              photos, notes et références restent privés.
            </p>
            <p class="mt-3 text-small text-ink-soft">Amis est facultatif et demande iOS 26 et iCloud.</p>
          </div>
          <AppScreenshot
            light={amisLight}
            dark={amisDark}
            alt="Onglet Amis de Stays : les séjours de Camille, en cours à Santorin et à venir à Kyoto et Milan, partagés sans prix, photo, note ni référence."
            class:list={[tileShot, tileShotStacked]}
            sizes={tileShotSizes}
          />
        </article>

        <!-- Ajout rapide -->
        <article class="tile reveal p-6 sm:p-8 lg:col-span-6" aria-labelledby="tuile-ajout">
          <svg class="h-7 w-7 text-accent" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="10.5" cy="10.5" r="6.25" stroke="currentColor" stroke-width="1.75"></circle>
            <path d="M15.25 15.25 20 20" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
          </svg>
          <h3 id="tuile-ajout" class="mt-5 text-heading text-ink">Ajout rapide.</h3>
          <p class="mt-3 text-ink-soft text-pretty">
            Cherchez l’hôtel dans Plans : Stays complète la ville, le pays et la chaîne. Un historique dans un tableur ?
            Importez-le depuis un fichier CSV.
          </p>
        </article>

        <!-- 100 % iOS et privé -->
        <article class="tile reveal p-6 sm:p-8 lg:col-span-6" aria-labelledby="tuile-prive">
          <svg class="h-7 w-7 text-accent" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="5" y="10.5" width="14" height="9.75" rx="2.25" stroke="currentColor" stroke-width="1.75"></rect>
            <path d="M8.25 10.5V7.75a3.75 3.75 0 0 1 7.5 0v2.75" stroke="currentColor" stroke-width="1.75"></path>
          </svg>
          <h3 id="tuile-prive" class="mt-5 text-heading text-ink">100 % iOS et privé.</h3>
          <p class="mt-3 text-ink-soft text-pretty">
            Une app native, écrite en SwiftUI. Vos séjours restent sur votre iPhone ; Amis passe par votre iCloud. Aucun
            serveur, aucune publicité, aucune revente de données.{' '}
            <a href="/privacy/" class="text-link">La politique de confidentialité</a>.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- Différenciation : pourquoi pas un tableur -->
  <section id="pourquoi" aria-labelledby="pourquoi-titre" class="border-t border-rule py-20 lg:py-28">
    <div class="page-shell grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4">
        <h2 id="pourquoi-titre" class="text-title text-ink text-balance">Pourquoi pas un tableur ?</h2>
        <p class="mt-5 text-ink-soft text-pretty">
          Un tableur garde des lignes. Stays garde vos séjours, et vous les rend quand vous en avez besoin.
        </p>
      </div>
      <div class="lg:col-span-8">
        <table class="compare w-full text-left">
          <caption class="sr-only">Comparaison entre un tableur ou des notes et Stays</caption>
          <thead>
            <tr class="border-b border-rule text-small text-ink-soft">
              <th scope="col" class="pb-3 font-normal"><span class="sr-only">Sujet</span></th>
              <th scope="col" class="pb-3 font-normal">Tableur ou notes</th>
              <th scope="col" class="pb-3 font-semibold text-ink">Stays</th>
            </tr>
          </thead>
          <tbody>
            {
              comparison.map((row) => (
                <tr class="border-b border-rule">
                  <th scope="row" class="py-4 pr-6 align-top font-semibold text-ink">
                    {row.topic}
                  </th>
                  <td data-label="Tableur ou notes" class="py-4 pr-6 align-top text-ink-soft">
                    {row.sheet}
                  </td>
                  <td data-label="Stays" class="py-4 align-top text-ink">
                    {row.stays}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- FAQ courte -->
  <section id="faq" aria-labelledby="faq-titre" class="border-t border-rule py-20 lg:py-28">
    <div class="page-shell grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-4">
        <h2 id="faq-titre" class="text-title text-ink text-balance">Questions fréquentes</h2>
        <p class="mt-5 text-ink-soft text-pretty">
          D’autres réponses et l’adresse de l’assistance sur la <a href="/support/" class="text-link"
            >page d’assistance</a
          >.
        </p>
      </div>
      <Faq items={homeFaq} class="lg:col-span-8" />
    </div>
  </section>

  <!-- Fin : rappel du téléchargement -->
  <section aria-labelledby="fin-titre" class="border-t border-rule py-20 lg:py-32">
    <div class="page-shell reveal flex flex-col items-center text-center">
      <img src="/stays-logo.png" alt="" width="72" height="72" class="h-18 w-18 rounded-[16px] shadow-shot" />
      <h2 id="fin-titre" class="mt-6 text-title text-ink text-balance">Stays, l’essentiel de vos séjours.</h2>
      <p class="mt-4 max-w-[30rem] text-ink-soft text-pretty">Téléchargez Stays et ajoutez votre prochain séjour.</p>
      <Availability class="mt-8" />
    </div>
  </section>
</Layout>
