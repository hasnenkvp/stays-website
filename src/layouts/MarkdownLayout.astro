---
import type { MarkdownHeading } from 'astro';
import Layout from '~/layouts/PageLayout.astro';
import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
    description?: string;
    lastUpdated?: string;
  };
  headings?: MarkdownHeading[];
}

const { frontmatter, headings = [] } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
  description: frontmatter?.description,
};

// Date affichée sous le titre, au format français (« 26 novembre 2026 »).
const lastUpdated = frontmatter?.lastUpdated ? new Date(`${frontmatter.lastUpdated}T12:00:00Z`) : undefined;
const lastUpdatedLabel = lastUpdated
  ? new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(
      lastUpdated
    )
  : undefined;

// Sommaire : un lien par section principale (titres de niveau 2).
const sections = headings.filter((heading) => heading.depth === 2);
---

<Layout metadata={metadata}>
  <article class="page-shell pt-12 pb-20 sm:pt-16 lg:pt-24 lg:pb-32">
    <div class="measure mx-auto">
      <header class="mb-12">
        <h1 class="text-display text-ink text-balance">{frontmatter.title}</h1>
        {
          lastUpdated && lastUpdatedLabel && (
            <p class="mt-4 text-small text-ink-soft">
              Dernière mise à jour : <time datetime={frontmatter.lastUpdated}>{lastUpdatedLabel}</time>
            </p>
          )
        }
      </header>

      {
        sections.length > 2 && (
          <nav aria-labelledby="sommaire" class="mb-14 rounded-2xl bg-canvas-alt p-5 sm:p-6">
            <h2 id="sommaire" class="text-small font-semibold text-ink-soft">
              Sommaire
            </h2>
            <ol class="mt-2">
              {sections.map((section) => (
                <li>
                  <a href={`#${section.slug}`} class="block rounded-md py-2.5 text-accent hover:text-accent-strong">
                    {section.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div
        class="prose max-w-none text-body break-words text-ink prose-headings:scroll-mt-8 prose-headings:font-semibold prose-headings:text-ink prose-h2:mt-20 prose-h2:mb-5 prose-h2:text-title prose-h3:mt-12 prose-h3:mb-3 prose-h3:text-heading prose-h4:mt-8 prose-h4:mb-2 prose-h4:text-body prose-p:my-4 prose-p:text-pretty prose-li:my-1.5 prose-ul:my-4 prose-ol:my-4 prose-strong:font-semibold prose-strong:text-ink prose-a:font-normal prose-a:text-accent prose-a:underline prose-a:decoration-accent/40 prose-a:underline-offset-[0.2em] hover:prose-a:decoration-accent prose-code:font-normal prose-code:text-ink prose-code:break-words prose-hr:border-rule marker:text-ink-soft"
      >
        <slot />
      </div>
    </div>
  </article>
</Layout>
