---
import Layout from '~/layouts/PageLayout.astro';
import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<Layout metadata={metadata}>
  <article class="py-16 sm:py-20 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <header class="mb-10 sm:mb-12">
        <div
          class="font-sans text-xs sm:text-[0.8125rem] tracking-[0.16em] uppercase font-semibold text-brass-ink dark:text-brass-light mb-3"
        >
          Document d'information
        </div>
        <h1 class="font-display font-light text-4xl sm:text-5xl md:text-6xl leading-[1.08] tracking-tight text-ink">
          {frontmatter.title}
        </h1>
      </header>

      <div
        class="prose prose-lg max-w-none dark:prose-invert font-sans text-ink-soft dark:text-sage break-words [overflow-wrap:anywhere] prose-code:break-words prose-headings:font-display prose-headings:font-light prose-headings:text-ink prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-rule prose-h3:text-xl sm:prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-3 prose-p:leading-[1.75] prose-p:text-[1.0625rem] prose-li:text-[1.0625rem] prose-li:leading-relaxed prose-a:text-forest dark:prose-a:text-brass-light prose-a:underline prose-a:underline-offset-4 hover:prose-a:text-forest-deep dark:hover:prose-a:text-white prose-blockquote:border-l-4 prose-blockquote:border-brass dark:prose-blockquote:border-brass-light prose-blockquote:bg-ivory-2/70 dark:prose-blockquote:bg-ivory-2/20 prose-blockquote:rounded-r-2xl prose-blockquote:py-4 prose-blockquote:px-6 prose-blockquote:not-italic prose-blockquote:text-sm prose-hr:border-rule dark:prose-hr:border-rule-inverse"
      >
        <slot />
      </div>
    </div>
  </article>
</Layout>
