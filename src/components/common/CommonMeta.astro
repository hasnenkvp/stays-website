---
import { getAsset } from '~/utils/permalinks';
import { stays } from '~/config/stays';
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<link rel="sitemap" href={getAsset('/sitemap-index.xml')} />

<meta name="theme-color" content="#FBF8F2" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0D1612" media="(prefers-color-scheme: dark)" />

{stays.appStoreId && <meta name="apple-itunes-app" content={`app-id=${stays.appStoreId}`} />}
