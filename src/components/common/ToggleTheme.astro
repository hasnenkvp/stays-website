---
import { Icon } from 'astro-icon/components';
import { UI } from 'astrowind:config';

export interface Props {
  label?: string;
  class?: string;
}

const { label = 'Basculer entre mode clair et mode sombre', class: className = '' } = Astro.props;
---

{
  !(UI.theme && UI.theme.endsWith(':only')) && (
    <aw-theme-toggle>
      <button
        type="button"
        role="switch"
        aria-checked="false"
        aria-label={label}
        title={label}
        data-aw-toggle-color-scheme
        class:list={[
          'theme-toggle-track group relative inline-flex shrink-0 cursor-pointer items-center justify-between rounded-full border border-rule/80 bg-ivory-2/90 transition-colors duration-200 dark:border-rule-inverse/60 dark:bg-forest-deep focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forest dark:focus-visible:ring-brass-light focus-visible:ring-offset-2 focus-visible:ring-offset-page select-none',
          className,
        ]}
      >
        <span
          class="theme-toggle-slot pointer-events-none flex items-center justify-center text-sage/40 opacity-0 transition-opacity duration-200 motion-reduce:transition-none dark:opacity-100"
          aria-hidden="true"
        >
          <span class="theme-toggle-icon-box flex items-center justify-center shrink-0">
            <Icon name="tabler:sun" class="block h-full w-full" />
          </span>
        </span>

        <span
          class="theme-toggle-slot pointer-events-none flex items-center justify-center text-ink-soft/40 opacity-100 transition-opacity duration-200 motion-reduce:transition-none dark:opacity-0"
          aria-hidden="true"
        >
          <span class="theme-toggle-icon-box flex items-center justify-center shrink-0">
            <Icon name="tabler:moon" class="block h-full w-full" />
          </span>
        </span>

        <span
          class="theme-toggle-thumb pointer-events-none absolute flex items-center justify-center rounded-full border border-rule/60 bg-ivory shadow-xs dark:border-rule-inverse/40 dark:bg-forest"
          aria-hidden="true"
        >
          <span class="theme-toggle-icon-box flex items-center justify-center shrink-0">
            <Icon name="tabler:sun" class="block h-full w-full text-brass dark:hidden" />
            <Icon name="tabler:moon" class="hidden h-full w-full text-brass-light dark:block" />
          </span>
        </span>
      </button>
    </aw-theme-toggle>
  )
}

<style>
  aw-theme-toggle {
    display: inline-flex;
    align-items: center;
  }

  .theme-toggle-track {
    --track-w: 56px;
    --track-h: 32px;
    --knob-size: 24px;
    --knob-offset: 3px;
    --icon-box-size: 14px;

    width: var(--track-w);
    height: var(--track-h);
    box-sizing: border-box;
    padding: var(--knob-offset);
  }

  .theme-toggle-slot {
    width: var(--knob-size);
    height: var(--knob-size);
    box-sizing: border-box;
  }

  .theme-toggle-thumb {
    width: var(--knob-size);
    height: var(--knob-size);
    box-sizing: border-box;
    top: var(--knob-offset);
    left: var(--knob-offset);
    right: auto;
  }

  :global(.dark) .theme-toggle-thumb {
    left: auto;
    right: var(--knob-offset);
  }

  .theme-toggle-icon-box {
    width: var(--icon-box-size);
    height: var(--icon-box-size);
    box-sizing: border-box;
  }
</style>

<script>
  class AwThemeToggle extends HTMLElement {
    connectedCallback() {
      const btn = this.querySelector<HTMLButtonElement>('[data-aw-toggle-color-scheme]');
      if (!btn) return;

      const syncState = () => {
        const isDark = document.documentElement.classList.contains('dark');
        btn.setAttribute('aria-checked', String(isDark));
        const newLabel = isDark ? 'Passer en mode clair' : 'Passer en mode sombre';
        btn.setAttribute('aria-label', newLabel);
        btn.title = newLabel;
      };

      // Set initial accessible state
      syncState();

      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.theme = isDark ? 'dark' : 'light';
        syncState();
        document.dispatchEvent(new CustomEvent('aw:theme-change'));
      });

      // Synchronize across client-side navigations (View Transitions)
      document.addEventListener('astro:page-load', syncState);
      document.addEventListener('astro:after-swap', syncState);
      document.addEventListener('aw:theme-change', syncState);

      // Respond to OS theme changes if user has not explicitly chosen a preference
      const media = window.matchMedia('(prefers-color-scheme: dark)');
      media.addEventListener('change', (e) => {
        if (!('theme' in localStorage)) {
          document.documentElement.classList.toggle('dark', e.matches);
          syncState();
          document.dispatchEvent(new CustomEvent('aw:theme-change'));
        }
      });
    }
  }

  if (!customElements.get('aw-theme-toggle')) {
    customElements.define('aw-theme-toggle', AwThemeToggle);
  }
</script>
