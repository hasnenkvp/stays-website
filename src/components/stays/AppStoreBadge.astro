---
import { stays } from '~/config/stays';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const badgeSrc = stays.appStoreBadge || '/app-store-badge-fr.svg';
---

{
  stays.appStoreUrl && (
    <a
      href={stays.appStoreUrl}
      target="_blank"
      rel="noopener"
      class:list={['inline-block rounded-lg transition-opacity duration-150 hover:opacity-85', className]}
    >
      <img
        src={badgeSrc}
        alt="Télécharger dans l’App Store"
        width="127"
        height="40"
        class="block h-11 w-auto"
        loading="eager"
        decoding="async"
      />
    </a>
  )
}
