---
import { stays } from '~/config/stays';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const hasScreenshot = Boolean(stays.screenshots?.hero?.src);
---

<div class:list={['relative w-full max-w-md mx-auto lg:max-w-none flex items-center justify-center', className]}>
  {
    hasScreenshot ? (
      <div class="relative rounded-[44px] p-2.5 bg-forest-deep dark:bg-black shadow-float border border-rule ring-1 ring-white/10 overflow-hidden max-w-[320px] mx-auto">
        <img
          src={stays.screenshots.hero.src}
          alt={stays.screenshots.hero.alt}
          width={stays.screenshots.hero.width}
          height={stays.screenshots.hero.height}
          class="rounded-[36px] w-full h-auto object-cover"
          loading="eager"
        />
      </div>
    ) : (
      <div class="relative w-full max-w-[420px] bg-gradient-to-br from-ivory/90 via-ivory-2/70 to-ivory/80 dark:from-ivory/80 dark:via-ivory-2/50 dark:to-ivory/60 border border-rule dark:border-rule/80 rounded-[32px] p-8 sm:p-12 shadow-card flex flex-col items-center justify-center text-center backdrop-blur-xs transition duration-300 hover:shadow-float">
        <div class="w-8 h-[2px] bg-brass dark:bg-brass-light mb-8 rounded-full" aria-hidden="true" />

        <div class="relative mb-6 group">
          <div
            class="absolute -inset-2 bg-forest/5 dark:bg-brass-light/10 rounded-[34px] blur-sm transition duration-300 group-hover:blur-md"
            aria-hidden="true"
          />
          <img
            src="/stays-logo.png"
            alt="Identité visuelle Stays"
            width="160"
            height="160"
            class="relative w-36 h-36 sm:w-40 sm:h-40 rounded-[28px] object-cover shadow-card ring-1 ring-forest/15 dark:ring-ivory/20 transition-transform duration-300 group-hover:scale-[1.02]"
            loading="eager"
          />
        </div>

        <div class="font-display italic text-2xl sm:text-[1.75rem] text-forest dark:text-brass-light font-normal tracking-tight mb-2">
          Votre carnet de séjours.
        </div>
        <p class="font-sans text-xs sm:text-sm text-ink-soft dark:text-sage tracking-wider uppercase font-medium">
          Application iOS · Conçue pour l'iPhone
        </p>

        <div class="w-12 h-px bg-rule dark:bg-rule-inverse mt-8" aria-hidden="true" />
      </div>
    )
  }
</div>
