---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import heroStayListImg from '~/assets/images/hero-stay-list.png';
import stayDetailImg from '~/assets/images/stay-detail.png';
import passportViewImg from '~/assets/images/passport-view.png';
import HeroLandscapeMockup from '~/components/stays/HeroLandscapeMockup.astro';

export interface Props {
  id: string;
  image?: ImageMetadata;
  title?: string;
  subtitle?: string;
  alt: string;
  class?: string;
  priority?: 'eager' | 'lazy';
}

const defaultImages: Record<string, ImageMetadata> = {
  hero: heroStayListImg,
  sejour: stayDetailImg,
  passeport: passportViewImg,
};

const defaultAlts: Record<string, string> = {
  hero: 'Écran d’accueil de l’application Stays présentant la liste des séjours',
  sejour: 'Fiche détaillée d’un séjour dans l’application Stays',
  passeport: 'Vue passeport de l’application Stays présentant les voyages et statistiques',
};

const { id, image, title = 'Aperçu', subtitle, alt: propAlt, class: className = '', priority = 'lazy' } = Astro.props;

const resolvedImage = image ?? defaultImages[id];
const alt = propAlt || defaultAlts[id] || 'Mockup de l’application Stays sur iPhone';
const hasImage = Boolean(resolvedImage);
const isEager = priority === 'eager';
const isHero = id === 'hero';
---

{
  isHero && hasImage ? (
    <HeroLandscapeMockup image={resolvedImage} alt={alt} priority={priority} class={className} />
  ) : (
    <div
      class:list={[
        'relative w-full flex items-center justify-center select-none overflow-hidden lg:overflow-visible pointer-events-none',
        className,
      ]}
      role="figure"
      aria-label={alt}
    >
      {hasImage ? (
        <div class="relative w-[540px] max-w-[540px] sm:w-[600px] sm:max-w-[600px] md:max-w-[640px] lg:w-[700px] lg:max-w-[700px] xl:w-[720px] xl:max-w-[720px] shrink-0">
          <Image
            src={resolvedImage}
            alt={alt}
            width={720}
            widths={[360, 540, 720, 1080, 1440, 2160]}
            sizes="(max-width: 640px) 540px, (max-width: 1024px) 640px, 720px"
            format="webp"
            quality={90}
            loading={isEager ? 'eager' : 'lazy'}
            decoding="async"
            fetchpriority={isEager ? 'high' : 'auto'}
            class="w-full h-auto object-contain block drop-shadow-none"
          />
        </div>
      ) : (
        <div class="relative w-full max-w-[340px] aspect-[393/852] rounded-[44px] p-6 text-center flex flex-col items-center justify-center bg-ivory-2/50 dark:bg-forest-deep border border-rule">
          <div class="w-12 h-12 rounded-[14px] bg-forest text-ivory flex items-center justify-center p-2.5 shadow-card mb-3.5">
            <img src="/stays-logo.png" alt="Stays" width="32" height="32" class="w-8 h-8 rounded-[8px] object-cover" />
          </div>
          <h3 class="font-display italic text-xl text-forest dark:text-brass-light font-normal tracking-tight mb-2">
            {title}
          </h3>
          {subtitle && <p class="font-sans text-xs text-ink-soft dark:text-sage leading-relaxed">{subtitle}</p>}
        </div>
      )}
    </div>
  )
}
