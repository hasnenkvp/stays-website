---
// Appel à l'action : le badge App Store, puis « Gratuit, pour iPhone ».
import AppStoreBadge from '~/components/stays/AppStoreBadge.astro';
import { stays } from '~/config/stays';

export interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['flex flex-col items-center gap-3', className]}>
  <AppStoreBadge size="lg" />
  <p class="inline-flex items-center gap-1.5 text-small text-ink-soft">
    <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <rect x="4" y="1.25" width="8" height="13.5" rx="2" stroke="currentColor" stroke-width="1.4"></rect>
      <path d="M7 12.25h2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
    </svg>
    {stays.ctaNote}
  </p>
</div>
