---
// Appel à l'action principal : le badge App Store quand l'app est publiée
// (stays.appStoreUrl renseigné), sinon une mention de disponibilité, sans lien.
import AppStoreBadge from '~/components/stays/AppStoreBadge.astro';
import { stays } from '~/config/stays';

export interface Props {
  class?: string;
  inverse?: boolean;
}

const { class: className = '', inverse = false } = Astro.props;
---

{
  stays.appStoreUrl ? (
    <AppStoreBadge class={className} />
  ) : (
    <p
      class:list={[
        'inline-flex items-center gap-2 font-sans text-[0.9375rem]',
        inverse ? 'text-sage' : 'text-ink-soft',
        className,
      ]}
    >
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <rect x="4" y="1.25" width="8" height="13.5" rx="2" stroke="currentColor" stroke-width="1.5" />
        <path d="M7 12.25h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      {stays.availabilityLabel}
    </p>
  )
}
