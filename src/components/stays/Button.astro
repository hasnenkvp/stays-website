---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'a'> {
  variant?: 'primary' | 'secondary';
  href: string;
  class?: string;
}

const { variant = 'primary', href, class: className = '', ...rest } = Astro.props;

const base =
  'inline-flex min-h-11 items-center justify-center rounded-full px-5 text-center text-body font-medium transition-colors duration-150 cursor-pointer';

const variants = {
  primary: 'bg-accent text-on-accent hover:bg-accent-strong',
  secondary: 'border border-rule text-accent hover:border-accent hover:text-accent-strong',
};
---

<a href={href} class:list={[base, variants[variant], className]} {...rest}>
  <slot />
</a>
