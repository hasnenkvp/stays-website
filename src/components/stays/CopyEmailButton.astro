---
export interface Props {
  email: string;
  label?: string;
  class?: string;
}

const { email, label = 'Copier l’adresse', class: className = '' } = Astro.props;
---

<div class="inline-block copy-email-container">
  <button
    type="button"
    class:list={[
      'copy-email-btn hidden items-center gap-2 text-sm font-sans font-medium text-forest dark:text-brass-light hover:text-forest-deep dark:hover:text-white px-3.5 py-1.5 rounded-full border border-rule hover:border-forest/40 dark:border-rule dark:hover:border-brass-light transition cursor-pointer focus-visible:outline-2 focus-visible:outline-brass-ink',
      className,
    ]}
    data-email={email}
    aria-label={`${label} (${email})`}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-4 h-4 icon-copy"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
    </svg>
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-4 h-4 icon-check hidden text-forest dark:text-brass-light"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
    <span class="btn-text">{label}</span>
  </button>
  <span class="sr-only aria-status" role="status" aria-live="polite"></span>
</div>

<script>
  function setupCopyButtons() {
    if (!navigator.clipboard) return;

    document.querySelectorAll('.copy-email-container').forEach((container) => {
      const btn = container.querySelector('.copy-email-btn') as HTMLButtonElement | null;
      const status = container.querySelector('.aria-status') as HTMLSpanElement | null;
      if (!btn) return;

      btn.classList.remove('hidden');
      btn.classList.add('inline-flex');

      btn.addEventListener('click', async () => {
        const email = btn.dataset.email;
        if (!email) return;

        try {
          await navigator.clipboard.writeText(email);
          const textSpan = btn.querySelector('.btn-text');
          const iconCopy = btn.querySelector('.icon-copy');
          const iconCheck = btn.querySelector('.icon-check');

          if (textSpan) textSpan.textContent = 'Adresse copiée !';
          if (iconCopy) iconCopy.classList.add('hidden');
          if (iconCheck) iconCheck.classList.remove('hidden');
          if (status) status.textContent = 'Adresse e-mail copiée dans le presse-papiers.';

          setTimeout(() => {
            if (textSpan) textSpan.textContent = 'Copier l’adresse';
            if (iconCopy) iconCopy.classList.remove('hidden');
            if (iconCheck) iconCheck.classList.add('hidden');
            if (status) status.textContent = '';
          }, 2000);
        } catch {
          // Fallback if permission denied
        }
      });
    });
  }

  setupCopyButtons();
  document.addEventListener('astro:after-swap', setupCopyButtons);
</script>
