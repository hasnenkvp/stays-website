---
export interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, lede, align = 'left', class: className = '' } = Astro.props;

const isCenter = align === 'center';
---

<div class:list={['mb-10 md:mb-14', { 'text-center mx-auto': isCenter }, className]}>
  {
    eyebrow && (
      <p class="font-sans text-[0.8125rem] tracking-[0.14em] uppercase font-semibold text-brass-ink dark:text-brass-light mb-3">
        {eyebrow}
      </p>
    )
  }

  <h2
    class="font-display font-light text-[2rem] sm:text-4xl md:text-5xl leading-[1.1] tracking-tight text-ink text-balance"
  >
    {title ? <Fragment set:html={title} /> : <slot name="title" />}
  </h2>

  {
    lede && (
      <p
        class:list={[
          'font-sans text-[1.0625rem] sm:text-lg text-ink-soft dark:text-sage leading-relaxed text-pretty mt-4',
          { 'mx-auto': isCenter },
          'max-w-2xl',
        ]}
      >
        {lede}
      </p>
    )
  }
  <slot />
</div>
