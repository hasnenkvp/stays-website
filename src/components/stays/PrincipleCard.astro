---
export interface Props {
  title: string;
  description: string;
  tagline?: string;
  class?: string;
}

const { title, description, tagline, class: className = '' } = Astro.props;
---

<div
  class:list={[
    'relative bg-ivory-2 dark:bg-ivory-2/40 border border-rule dark:border-rule/80 rounded-[24px] p-7 sm:p-8 flex flex-col justify-between transition-all duration-300 hover:shadow-card hover:-translate-y-1',
    className,
  ]}
>
  <div>
    <!-- Brass decorative accent rule -->
    <div class="w-10 h-[2px] bg-brass dark:bg-brass-light mb-6 rounded-full" aria-hidden="true"></div>

    {
      tagline && (
        <div class="text-[0.6875rem] uppercase tracking-[0.14em] font-semibold text-brass-ink dark:text-brass-light mb-2">
          {tagline}
        </div>
      )
    }

    <h3 class="font-display font-medium text-2xl sm:text-[1.625rem] text-ink tracking-tight mb-3">
      {title}
    </h3>

    <p class="font-sans text-[0.9375rem] sm:text-base text-ink-soft dark:text-sage leading-relaxed">
      {description}
    </p>
  </div>
</div>
