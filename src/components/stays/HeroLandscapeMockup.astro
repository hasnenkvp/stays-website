---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import heroStayListImg from '~/assets/images/hero-stay-list.png';

export interface Props {
  image?: ImageMetadata;
  alt?: string;
  class?: string;
  priority?: 'eager' | 'lazy';
}

const {
  image = heroStayListImg,
  alt = 'Application Stays sur iPhone posé à plat présentant la liste des séjours',
  class: className = '',
  priority = 'eager',
} = Astro.props;

const isEager = priority === 'eager';
---

<div
  class:list={[
    'relative w-full max-w-lg sm:max-w-2xl md:max-w-4xl lg:max-w-5xl xl:max-w-6xl mx-auto flex items-center justify-center select-none pointer-events-none',
    className,
  ]}
  role="figure"
  aria-label={alt}
>
  <Image
    src={image}
    alt={alt}
    width={1280}
    height={720}
    widths={[480, 768, 1024, 1280, 1600, 2048, 2560]}
    sizes="(max-width: 640px) 100vw, (max-width: 1024px) 92vw, (max-width: 1280px) 1024px, 1152px"
    format="webp"
    quality={90}
    loading={isEager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={isEager ? 'high' : 'auto'}
    class="w-full h-auto object-contain block drop-shadow-none"
  />
</div>
