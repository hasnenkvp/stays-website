---
// Capture d'écran de l'app dans un cadre de téléphone dessiné en CSS : léger,
// net à toutes les tailles, et sans image de produit Apple.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  /** Largeur affichée, pour le choix de la bonne résolution. */
  sizes?: string;
  loading?: 'eager' | 'lazy';
}

const { src, alt, class: className = '', sizes = '(max-width: 640px) 240px, 300px', loading = 'lazy' } = Astro.props;
---

<figure class:list={['phone-frame relative m-0', className]}>
  <div
    class="rounded-[2.4rem] bg-[#121614] p-[0.5rem] shadow-phone ring-1 ring-black/5 dark:ring-white/12 sm:rounded-[2.75rem] sm:p-[0.6rem]"
  >
    <Image
      src={src}
      alt={alt}
      widths={[240, 360, 480, 600, 720, 900]}
      sizes={sizes}
      format="webp"
      quality={82}
      loading={loading}
      decoding="async"
      class="block h-auto w-full rounded-[1.95rem] sm:rounded-[2.2rem] dark:brightness-[0.92]"
    />
  </div>
</figure>
