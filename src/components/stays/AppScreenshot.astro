---
// Capture d'écran de l'app, droite et nette : coins d'un écran d'iPhone, un filet
// et une ombre portée très légère. Pas de cadre de téléphone dessiné.
// Deux versions : claire par défaut, sombre quand le système est en mode sombre
// (<source media="(prefers-color-scheme: dark)">, sans JavaScript).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  light: ImageMetadata;
  dark: ImageMetadata;
  alt: string;
  class?: string;
  /** Largeur affichée, pour le choix de la bonne résolution. */
  sizes?: string;
  /** Capture du premier écran : chargée tout de suite, en priorité. */
  priority?: boolean;
}

const {
  light,
  dark,
  alt,
  class: className = '',
  sizes = '(max-width: 640px) 260px, 300px',
  priority = false,
} = Astro.props;

// Largeurs générées : de 260 px (1x) jusqu'à la capture d'origine (1 320 px),
// pour rester nettes sur les écrans @2x et @3x.
const options = { widths: [260, 320, 360, 520, 640, 720, 780, 960, 1080, 1320], format: 'webp' as const, quality: 85 };
const [lightImage, darkImage] = await Promise.all([
  getImage({ src: light, ...options }),
  getImage({ src: dark, ...options }),
]);
---

<picture class:list={['block', className]}>
  <source media="(prefers-color-scheme: dark)" type="image/webp" srcset={darkImage.srcSet.attribute} sizes={sizes} />
  <img
    src={lightImage.src}
    srcset={lightImage.srcSet.attribute}
    sizes={sizes}
    alt={alt}
    width={light.width}
    height={light.height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding="async"
    class="app-shot block h-auto w-full"
  />
</picture>
