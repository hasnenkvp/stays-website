---
import { getHomePermalink } from '~/utils/permalinks';
import Logo from '~/components/Logo.astro';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  footNote?: string;
}

const { links = [], footNote = '' } = Astro.props;
---

<footer class="relative bg-forest-deep text-[#fbf8f2] border-t border-rule-inverse not-prose" data-surface="inverse">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <div class="grid grid-cols-12 gap-8 lg:gap-12">
      <div class="col-span-12 lg:col-span-4 space-y-4">
        <a
          class="inline-flex min-h-11 items-center text-[#fbf8f2] rounded-md"
          href={getHomePermalink()}
          aria-label="Stays, accueil"
        >
          <Logo inverse={true} />
        </a>
        <p class="text-[0.9375rem] text-sage max-w-sm leading-relaxed">
          Stays est une application iOS privée pour garder la mémoire de vos séjours : hôtels, lieux, dates et
          souvenirs.
        </p>
      </div>

      <nav class="col-span-12 lg:col-span-8 grid grid-cols-1 sm:grid-cols-3 gap-8" aria-label="Pied de page">
        {
          links.map(({ title, links }) => (
            <div>
              <h2 class="font-display font-medium text-lg text-[#fbf8f2] tracking-tight mb-2">{title}</h2>
              {links && links.length > 0 && (
                <ul class="text-[0.9375rem]">
                  {links.map(({ text, href, ariaLabel }) => (
                    <li>
                      <a
                        class="inline-flex min-h-11 items-center text-sage hover:text-[#fbf8f2] hover:underline underline-offset-4 transition-colors duration-150"
                        href={href}
                        aria-label={ariaLabel}
                      >
                        {text}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </nav>
    </div>

    <div class="border-t border-rule-inverse mt-10 pt-6 text-sm text-sage">
      <p>{footNote}</p>
    </div>
  </div>
</footer>
