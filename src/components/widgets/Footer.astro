---
export interface Props {
  links: Array<{ text: string; href: string }>;
  footNote: string;
}

const { links = [], footNote } = Astro.props;
---

<footer class="border-t border-rule">
  <div
    class="page-shell flex flex-col gap-2 pt-8 pb-[max(2rem,env(safe-area-inset-bottom))] text-small text-ink-soft sm:flex-row sm:items-center sm:justify-between"
  >
    <p>{footNote}</p>
    <nav aria-label="Pied de page">
      <ul class="-mx-2 flex flex-wrap">
        {
          links.map(({ text, href }) => (
            <li>
              <a
                class="inline-flex min-h-11 items-center rounded-md px-2 transition-colors duration-150 hover:text-ink"
                href={href}
              >
                {text}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
