---
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import AppStoreBadge from '~/components/stays/AppStoreBadge.astro';
import { getHomePermalink } from '~/utils/permalinks';

export interface Props {
  id?: string;
  isSticky?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  links?: Array<{ text?: string; href?: string }>;
}

const { id = 'header', isSticky = true, isFullWidth = false, showToggleTheme = true, links = [] } = Astro.props;

// Page courante, pour aria-current et le style actif.
const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
const isCurrent = (href = '') => href !== '/' && currentPath === href.replace(/\/?$/, '/');
---

<aw-header>
  <header
    class:list={[
      { sticky: isSticky, relative: !isSticky },
      'top-0 z-40 flex-none mx-auto w-full border-b border-rule/50 bg-page/90 backdrop-blur-md transition-colors duration-200',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div
      class:list={[
        'flex items-center justify-between gap-3 py-2 px-4 sm:px-6 mx-auto w-full min-h-14',
        {
          'max-w-7xl': !isFullWidth,
        },
      ]}
    >
      <a
        class="flex min-h-11 items-center text-ink rounded-md hover:opacity-90"
        href={getHomePermalink()}
        aria-label="Stays, accueil"
      >
        <Logo />
      </a>

      <div class="flex items-center gap-1 sm:gap-3">
        {
          links.length > 0 && (
            <nav aria-label="Navigation principale">
              <ul class="flex items-center gap-1 sm:gap-2">
                {links.map(({ text, href }, index) => (
                  <li class:list={[{ 'hidden sm:block': index > 0 }]}>
                    <a
                      href={href}
                      aria-current={isCurrent(href) ? 'page' : undefined}
                      class:list={[
                        'inline-flex min-h-11 items-center rounded-md px-2 font-sans text-[0.9375rem] font-medium transition-colors duration-150',
                        isCurrent(href)
                          ? 'text-ink underline decoration-brass-ink decoration-2 underline-offset-[6px]'
                          : 'text-ink-soft hover:text-ink',
                      ]}
                    >
                      {text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <AppStoreBadge class="shrink-0 hidden sm:inline-block" />
        {showToggleTheme && <ToggleTheme />}
      </div>
    </div>
  </header>
</aw-header>

<style>
  aw-header {
    display: contents;
  }
</style>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('#header');

      // En-tête collant : classe `scroll` au-delà de 60 px de défilement (ombre légère).
      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          if (window.scrollY > 60) header.classList.add('scroll');
          else header.classList.remove('scroll');
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
    }
  }

  if (!customElements.get('aw-header')) {
    customElements.define('aw-header', AwHeader);
  }
</script>
