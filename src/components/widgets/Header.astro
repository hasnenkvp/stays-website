---
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import AppStoreBadge from '~/components/stays/AppStoreBadge.astro';
import { getHomePermalink } from '~/utils/permalinks';

export interface Props {
  id?: string;
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  // Kept for backward compatibility if passed by layouts
  links?: Array<unknown>;
  actions?: Array<unknown>;
  position?: string;
}

const { id = 'header', isSticky = true, isDark = false, isFullWidth = false, showToggleTheme = true } = Astro.props;
---

<aw-header transition:persist="header-global">
  <header
    class:list={[
      { sticky: isSticky, relative: !isSticky, dark: isDark },
      'top-0 z-40 flex-none mx-auto w-full border-b border-rule/50 bg-page/90 backdrop-blur-md transition-colors duration-200',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div
      class:list={[
        'flex items-center justify-between py-3 px-4 sm:px-6 mx-auto w-full',
        {
          'max-w-7xl': !isFullWidth,
        },
      ]}
    >
      <!-- À gauche : Logo Stays avec lien vers l'accueil -->
      <a
        class="flex items-center text-ink rounded-md transition-transform duration-200 hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-forest dark:focus-visible:ring-brass-light"
        href={getHomePermalink()}
        aria-label="Accueil Stays"
      >
        <Logo />
      </a>

      <!-- À droite : Badge App Store puis Switch clair/sombre -->
      <div class="flex items-center gap-3 sm:gap-4">
        <AppStoreBadge class="shrink-0" />
        {showToggleTheme && <ToggleTheme />}
      </div>
    </div>
  </header>
</aw-header>

<style>
  aw-header {
    display: contents;
  }
</style>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('#header');

      // Sticky header: toggle la classe `scroll` au-delà du seuil de défilement
      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          if (window.scrollY > 60) header.classList.add('scroll');
          else header.classList.remove('scroll');
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
    }
  }

  if (!customElements.get('aw-header')) {
    customElements.define('aw-header', AwHeader);
  }
</script>
