---
// CustomStyles.astro - Stays Design System
// Typography provided by Astro Fonts API (Newsreader & Instrument Sans)
---

<style is:inline>
  :root {
    --font-newsreader: var(--font-newsreader);
    --font-instrument-sans: var(--font-instrument-sans);

    --aw-font-sans: var(--font-instrument-sans), -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --aw-font-serif: var(--font-newsreader), 'Iowan Old Style', Georgia, serif;
    --aw-font-heading: var(--font-newsreader), 'Iowan Old Style', Georgia, serif;

    /* Stays Brand Palette (Light) */
    --color-paper: #fbf8f2;
    --color-ivory: #f6f1e7;
    --color-ivory-2: #ece4d3;
    --color-forest: #1f3b2d;
    --color-forest-deep: #16291f;
    --color-moss: #3e5a48;
    --color-sage: #c9d3c4;
    --color-ink: #1c221e;
    --color-ink-soft: #59605a;
    --color-brass: #8a6a2e;
    --color-brass-ink: #6f5422;
    --color-brass-light: #d9b877;
    --color-rule: rgba(28, 34, 30, 0.12);
    --color-rule-inverse: rgba(246, 241, 231, 0.18);

    /* AstroWind compatibility mappings */
    --aw-color-primary: #1f3b2d;
    --aw-color-secondary: #3e5a48;
    --aw-color-accent: #8a6a2e;
    --aw-color-text-heading: #1c221e;
    --aw-color-text-default: #1c221e;
    --aw-color-text-muted: #59605a;
    --aw-color-bg-page: #fbf8f2;

    --radius-card: 24px;
    --shadow-card: 0 1px 0 rgba(255, 255, 255, 0.6) inset, 0 18px 36px -24px rgba(22, 41, 31, 0.3);
    --shadow-float: 0 30px 60px -30px rgba(22, 41, 31, 0.45), 0 6px 14px rgba(22, 41, 31, 0.08);

    color-scheme: light;
  }

  .dark {
    --aw-font-sans: var(--font-instrument-sans), -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --aw-font-serif: var(--font-newsreader), 'Iowan Old Style', Georgia, serif;
    --aw-font-heading: var(--font-newsreader), 'Iowan Old Style', Georgia, serif;

    /* Stays Brand Palette (Dark - deep forest night) */
    --color-paper: #0d1612;
    --color-ivory: #14221b;
    --color-ivory-2: #1a2b23;
    --color-forest: #244636;
    --color-forest-deep: #162b21;
    --color-moss: #4a6e59;
    --color-sage: #b4c4b1;
    --color-ink: #f5efe6;
    --color-ink-soft: #a8b5aa;
    --color-brass: #d9b877;
    --color-brass-ink: #e8cc96;
    --color-brass-light: #ebd6a7;
    --color-rule: rgba(245, 239, 230, 0.12);
    --color-rule-inverse: rgba(245, 239, 230, 0.18);

    /* AstroWind compatibility mappings */
    --aw-color-primary: #244636;
    --aw-color-secondary: #4a6e59;
    --aw-color-accent: #d9b877;
    --aw-color-text-heading: #f5efe6;
    --aw-color-text-default: #f5efe6;
    --aw-color-text-muted: #a8b5aa;
    --aw-color-bg-page: #0d1612;

    color-scheme: dark;
  }

  body {
    background-color: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--aw-font-sans);
  }

  /* Selection colors */
  ::selection {
    background-color: var(--color-sage);
    color: var(--color-forest-deep);
  }
  .dark ::selection {
    background-color: var(--color-moss);
    color: var(--color-ivory);
  }
</style>
